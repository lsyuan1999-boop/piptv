# 复制成 .env.local 后填写。不要把 .env.local 提交到仓库。

# Neon 数据库连接串
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 管理员登录密码，请用强密码
ADMIN_PASSWORD=""

# 给登录 Cookie 签名，至少 32 位随机字符
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Vercel Blob 存储（图片上传）
# 在 Vercel 项目设置 → Storage → Connect Store → Blob 创建后自动添加
# 本地开发时需要手动从 Vercel 复制过来
BLOB_READ_WRITE_TOKEN=""

# 展示时区与站点信息
NEXT_PUBLIC_TIMEZONE="Asia/Shanghai"
NEXT_PUBLIC_TIMEZONE_LABEL="北京时间"
NEXT_PUBLIC_SITE_TITLE="直播日程"
